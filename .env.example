# FastAPIバックエンド(devex-api)のベースURL。src/lib/api/client.tsが参照する。
# 未設定時は http://localhost:8000 にフォールバックする。
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google でのログインの OAuth クライアント ID(devex-api の GOOGLE_CLIENT_ID と同じ値)。未設定・空なら
# ログイン・登録の画面に Google のボタンを出さない。手元では承認済みの JavaScript 生成元に
# http://localhost:3000 を入れたクライアントを使う。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# E2E 専用。true のとき本物の Google のボタンの代わりに、偽の credential を送るボタンを出す
# (playwright.config.ts が E2E の dev サーバーに渡す)。本番・通常の開発では書かない。
# NEXT_PUBLIC_E2E_FAKE_GOOGLE=true
